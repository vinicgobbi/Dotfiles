{
	"layer": "bottom",
	"modules-left": [
		"sway/workspaces",
		"sway/mode",
		"network",
		"bluetooth",
		"custom/vpn"
	],
	"modules-center": [
		"custom/media"
	],
	"modules-right": [
		"keyboard-state",
		"pulseaudio",
		"backlight",
		"battery",
		"power-profiles-daemon",
		"clock",
		"tray",
		"custom/power"
	],
	"pulseaudio": {
		"format": "{icon} {volume}%",
		"on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
		"on-click-right": "pavucontrol",
		"format-muted": "🔇 {volume}%",
		"format-icons": {
			"default": "🔊"
		}
	},
	"battery": {
		"format": "🔋 {capacity}%",
		"format-icons": {
			"default": "🔋"
		}
	},
	"backlight": {
		"format": "💡 {percent}%",
		"format-icons": {
			"default": "💡"
		}
	},
	"clock": {
		"format": "🕒 {:%R}",
		"format-alt": "📅 {:%R - %A - %d/%m/%y}",
		"tooltip": true,
		"tooltip-format": "{:%R - %A - %d/%m/%y}"
	},
	"custom/media": {
		"format": "{icon} {text}",
		"return-type": "json",
		"max-length": 50,
		"escape": true,
		"format-icons": {
			"spotify": "🎵",
			"cmus": "🎵",
			"firefox": "🌐",
			"chromium": "🌐",
			"paused": "⏸️",
			"default": "▶️"
		},
		"exec": "/home/vinicius/.config/waybar/scripts/mediaplayer.py 2> /dev/null"
	},
	"sway/workspaces": {
		"format": "{icon} {name}",
		"format-icons": {
			"focused": "◉",
			"default": "○"
		}
	},
	"tray": {
		"icon-size": 18,
		"spacing": 15
	},
	"custom/vpn": {
		"exec": "/home/vinicius/.config/waybar/scripts/vpn_toggle.py",
		"return-type": "json",
		"format": "{icon} {text}",
		"on-click": "/home/vinicius/.config/waybar/scripts/vpn_toggle.py --toggle",
		"format-icons": {
			"active": "🛡️🟢",
			"inactive": "🛡️🔴",
			"default": "❔"
		}
	},
	"custom/power": {
		"return-type": "json",
		"format": "{icon}",
		"on-click": "wlogout",
		"format-icons": {
			"default": "🔌"
		}
	},
	"keyboard-state": {
		"numlock": true,
		"capslock": true,
		"format": "{name} {icon}",
		"format-icons": {
			"locked": "🔒",
			"unlocked": "🔑"
		},
		"tooltip": true,
		"tooltip-format": "{name}: {state}"
	},
	"network": {
		"format-wifi": "📡 {essid}",
		"tooltip-format": "{ifname} via {gwaddr} ⦙ IP: {ipaddr}/{cidr}",
		"format-ethernet": "🌐 {ifname}",
		"format-disconnected": "❌ Disconnected",
		"on-click": "nm-connection-editor"
	},
	"bluetooth": {
		"format": "🔗 {status}",
		"format-connected": "🎧 {device_alias}",
		"format-connected-battery": "🎧 {device_alias} ({device_battery}%)",
		"format-disabled": "🚫 Off",
		"format-off": "🚫 Off",
		"format-on": "🔗 On",
		"tooltip-format": "{controller_alias}\n{controller_address}\nStatus: {status}",
		"on-click": "blueman-manager",
		"on-click-right": "rfkill toggle bluetooth"
	},
	"power-profiles-daemon": {
		"format": "{icon} {profile}",
		"format-icons": {
			"performance": "🚀",
			"balanced": "⚙️",
			"power-saver": "🪫"
		},
		"tooltip-format": "Modo atual: {profile}\nDriver: {driver}",
		"on-click": "~/.config/waybar/scripts/power-toggle.sh"
	}
}