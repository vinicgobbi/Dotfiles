{
	"layer": "bottom",
	"modules-left": [
		"sway/workspaces",
		"sway/mode",
		"network",
		"bluetooth",
		"custom/vpn"
	],
	"modules-center": [
		"custom/media"
	],
	"modules-right": [
		"keyboard-state",
		"pulseaudio",
		"backlight",
		"battery",
		"power-profiles-daemon",
		"clock",
		"tray",
		"custom/power"
	],
	"pulseaudio": {
		"format": "<span size='135%' font_family='FiraCode Nerd Font Mono'>{icon}</span> {volume}%",
		"on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
		"on-click-right": "pavucontrol",
		"format-muted": "<span size='135%' font_family='FiraCode Nerd Font Mono'></span> {volume}%",
		"format-icons": {
			"default": ""
		}
	},
	"battery": {
		"format": "<span size='135%' font_family='FiraCode Nerd Font Mono'>{icon}</span> {capacity}%",
		"format-icons": [
			"",
			"",
			"",
			"",
			""
		]
	},
	"backlight": {
		"format": "<span size='135%' font_family='FiraCode Nerd Font Mono'>{icon}</span> {percent}%",
		"format-icons": {
			"default": ""
		}
	},
	"clock": {
		"format": "<span size='135%' font_family='FiraCode Nerd Font Mono'></span> {:%R}",
		"format-alt": "<span size='135%' font_family='FiraCode Nerd Font Mono'></span> {:%R - %A - %d/%m/%y}",
		"tooltip": true,
		"tooltip-format": "{:%R - %A - %d/%m/%y}"
	},
	"custom/media": {
		"format": "<span size='135%' font_family='FiraCode Nerd Font Mono'>{icon}</span> {text}",
		"return-type": "json",
		"max-length": 50,
		"escape": true,
		"format-icons": {
			"spotify": "",
			"cmus": "",
			"firefox": "",
			"chromium": "",
			"paused": "",
			"default": ""
		},
		"exec": "/home/vinicius/.config/waybar/scripts/mediaplayer.py 2> /dev/null"
	},
	"sway/workspaces": {
		"format": "{icon} {name}",
		"format-icons": {
			"focused": "●",
			"default": "○"
		}
	},
	"tray": {
		"icon-size": 18,
		"spacing": 15
	},
	"custom/vpn": {
		"exec": "/home/vinicius/.config/waybar/scripts/vpn_toggle.py",
		"return-type": "json",
		"format": "<span size='135%' font_family='FiraCode Nerd Font Mono'>{icon}</span> {text}",
		"on-click": "/home/vinicius/.config/waybar/scripts/vpn_toggle.py --toggle",
		"format-icons": {
			"default": ""
		}
	},
	"custom/power": {
		"return-type": "json",
		"format": "<span size='135%' font_family='FiraCode Nerd Font Mono'>{icon}</span>",
		"on-click": "wlogout",
		"format-icons": {
			"default": ""
		}
	},
	"keyboard-state": {
		"numlock": true,
		"capslock": true,
		"format": "{name} <span size='135%' font_family='FiraCode Nerd Font Mono'>{icon}</span> ",
		"format-icons": {
			"locked": "",
			"unlocked": ""
		}
	},
	"network": {
		"format-wifi": "<span size='135%' font_family='FiraCode Nerd Font Mono'></span> {essid}",
		"tooltip-format": "{ifname} via {gwaddr} ⦙ IP: {ipaddr}/{cidr}",
		"format-ethernet": "<span size='135%' font_family='FiraCode Nerd Font Mono'></span> {ifname}",
		"format-disconnected": "<span size='135%' font_family='FiraCode Nerd Font Mono'></span> Disconnected",
		"on-click": "nm-connection-editor"
	},
	"bluetooth": {
		"format": "<span size='135%' font_family='FiraCode Nerd Font Mono'></span> {status}",
		"format-connected": "<span size='135%' font_family='FiraCode Nerd Font Mono'></span> {device_alias}",
		"format-connected-battery": "<span size='135%' font_family='FiraCode Nerd Font Mono'></span> {device_alias} ({device_battery_percentage}%)",
		"format-disabled": "<span size='135%' font_family='FiraCode Nerd Font Mono'></span> Off",
		"format-off": "<span size='135%' font_family='FiraCode Nerd Font Mono'></span> Off",
		"format-on": "<span size='135%' font_family='FiraCode Nerd Font Mono'></span> On",
		"tooltip-format": "{controller_alias}\n{controller_address}\nStatus: {status}",
		"on-click": "blueman-manager",
		"on-click-right": "rfkill toggle bluetooth"
	},
	"power-profiles-daemon": {
		"format": "<span size='135%' font_family='FiraCode Nerd Font Mono'>{icon}</span> {profile}",
		"format-icons": {
			"performance": "",
			"balanced": "",
			"power-saver": ""
		},
		"tooltip-format": "Modo atual: {profile}\nDriver: {driver}",
		"on-click": "/home/vinicius/.config/waybar/scripts/power-toggle.sh"
	}
}
