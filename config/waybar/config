{
	"layer": "bottom",
	"modules-left": [
		"sway/workspaces",
		"sway/mode",
		"custom/vpn"
	],
	"modules-center": [
		"custom/media"
	],
	"modules-right": [
		"keyboard-state",
		"pulseaudio",
		"backlight",
		"battery",
		"clock",
		"tray",
		"custom/power"
	],
	"pulseaudio": {
		"format": "{icon} {volume}%",
		"on-click": "pavucontrol",
		"format-muted": "🔇 {volume}%",
		"format-icons": {
			"default": "🔊"
		}
	},
	"battery": {
		"format": "🔋 {capacity}%",
		"format-icons": {
			"default": "🔋"
		}
	},
	"backlight": {
		"format": "💡 {percent}%",
		"format-icons": {
			"default": "💡"
		}
	},
	"clock": {
		"format": "🕒 {:%R}",
		"format-alt": "📅 {:%R - %A - %d/%m/%y}",
		"tooltip": true,
		"tooltip-format": "{:%R - %A - %d/%m/%y}"
	},
	"custom/media": {
		"format": "{icon} {text}",
		"return-type": "json",
		"max-length": 50,
		"format-icons": {
			"spotify": "🎵",
			"cmus": "🎵",
			"firefox": "🌐",
			"chromium": "🌐",
			"paused": "⏸️",
			"default": "▶️"
		},
		"exec": "/home/vinicius/.config/waybar/mediaplayer.py 2> /dev/null"
	},
	"sway/workspaces": {
		"format": "{icon} {name}",
		"format-icons": {
			"focused": "◉",
			"default": "○"
		}
	},
	"tray": {
		"icon-size": 18,
		"spacing": 15
	},
	"custom/vpn": {
		"exec": "/home/vinicius/.config/waybar/vpn_toggle.py",
		"return-type": "json",
		"format": "{icon} {text}",
		"on-click": "/home/vinicius/.config/waybar/vpn_toggle.py --toggle",
		"format-icons": {
			"active": "🛡️🟢",
			"inactive": "🛡️🔴",
			"default": "❔"
		}
	},
	"custom/power": {
		"exec": "/home/vinicius/.config/waybar/power_menu.py",
		"return-type": "json",
		"format": "{icon}",
		"on-click": "/home/vinicius/.config/waybar/power_menu.py --show-menu",
		"format-icons": {
			"default": "🔌"
		}
	},
	"keyboard-state": {
		"numlock": true,
		"capslock": true,
		"format": "{name} {icon}",
		"format-icons": {
			"locked": "🔒",
			"unlocked": "🔓"
		},
		"tooltip": true,
		"tooltip-format": "{name}: {state}"
	}
}