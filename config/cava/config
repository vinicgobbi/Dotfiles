## Configuration file for CAVA - Libadwaita Dark Theme
# Remove the ; to change parameters.


[general]

; framerate = 60
; autosens = 1

; sensitivity = 100

# Ajustado para uma aparência mais limpa e moderna
bars = 0
bar_width = 1
bar_spacing = 1

; center_align = 1
; max_height = 100

; lower_cutoff_freq = 50
; higher_cutoff_freq = 10000

; sleep_timer = 0


[input]

# Mantenha o método que funciona para seu sistema
# (PulseAudio é geralmente o padrão se você não usa PipeWire)
;method = pulse
;source = auto

# Se você usa PipeWire, descomente este:
method = pipewire
source = auto


[output]

method = noncurses
orientation = bottom
channels = stereo
; mono_option = average
; reverse = 0


[color]

# --- Tema Libadwaita Dark ---

# Cor de fundo oficial: @window_bg_color
background = '#242424'

# Ativa o modo gradiente
gradient = 1

# Gradiente que vai do Azul (acento) ao Branco (texto)
gradient_color_1 = '#3584e4' # @accent_bg_color
gradient_color_2 = '#3584e4'
gradient_color_3 = '#78aeed' # @accent_fg_color
gradient_color_4 = '#78aeed'
gradient_color_5 = '#dedede' # @inactive_fg_color
gradient_color_6 = '#dedede'
gradient_color_7 = '#ffffff' # @window_fg_color
gradient_color_8 = '#ffffff'


[smoothing]

# --- Efeito de Ondas (Monstercat) ---
# Muito mais suave e moderno que o 'gravity'
monstercat = 1
waves = 1

# Desativados para usar o monstercat
; gravity = 100
; noise_reduction = 77
; integral = 77
; ignore = 0

[eq]

; 1 = 1 # bass
; 2 = 1
; 3 = 1 # midtone
; 4 = 1
; 5 = 1 # treble