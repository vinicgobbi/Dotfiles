## Configuration file for CAVA - Dracula Theme
# Remove the ; to change parameters.


[general]

; framerate = 60
; autosens = 1

; sensitivity = 100

# Ajustado para uma aparência mais limpa e moderna
bars = 0
bar_width = 1
bar_spacing = 1

; center_align = 1
; max_height = 100

; lower_cutoff_freq = 50
; higher_cutoff_freq = 10000

; sleep_timer = 0


[input]

# Mantenha o método que funciona para seu sistema
# (PulseAudio é geralmente o padrão se você não usa PipeWire)
;method = pulse
;source = auto

# Se você usa PipeWire, descomente este:
method = pipewire
source = auto


[output]

method = noncurses
orientation = bottom
channels = stereo
; mono_option = average
; reverse = 0


[color]

# --- Tema Dracula ---

# Cor de fundo oficial: Background
background = '#282a36'

# Ativa o modo gradiente
gradient = 1

# Gradiente que vai do Purple (acento) ao Foreground (texto)
gradient_color_1 = '#bd93f9' # Purple
gradient_color_2 = '#bd93f9'
gradient_color_3 = '#8be9fd' # Cyan
gradient_color_4 = '#8be9fd'
gradient_color_5 = '#6272a4' # Comment
gradient_color_6 = '#6272a4'
gradient_color_7 = '#f8f8f2' # Foreground
gradient_color_8 = '#f8f8f2'


[smoothing]

# --- Efeito de Ondas (Monstercat) ---
# Muito mais suave e moderno que o 'gravity'
monstercat = 1
waves = 1

# Desativados para usar o monstercat
; gravity = 100
; noise_reduction = 77
; integral = 77
; ignore = 0

[eq]

; 1 = 1 # bass
; 2 = 1
; 3 = 1 # midtone
; 4 = 1
; 5 = 1 # treble