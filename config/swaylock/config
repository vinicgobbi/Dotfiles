# ==================================
# Config do Swaylock - Dracula
# ==================================

# --- Efeitos e Comportamento (Mantidos) ---
daemonize
show-failed-attempts
clock
screenshot
effect-blur=13x13
effect-vignette=0.5:0.5
indicator
indicator-radius=200
indicator-thickness=20
grace=2
grace-no-mouse
grace-no-touch
datestr=%a, %B %e
timestr=%H:%M
fade-in=0.4
ignore-empty-password

# --- Fonte (Coerência com Adwaita) ---
font="Adwaita Sans"

# --- Cor de Fundo (Fallback) ---
# Background
color=282a36

# --- Cores do Indicador (Padrão) ---
# Background
line-color=282a36
# Purple (acento)
ring-color=bd93f9
# Current Line / Selection (cinza interno)
inside-color=44475a

# --- Cores do Texto (Padrão) ---
# Foreground (branco)
text-color=f8f8f2
# Yellow
text-caps-lock-color=f1fa8c

# --- Destaque de Tecla ---
# Green
key-hl-color=50fa7b

# --- Separador ---
separator-color=00000000

# --- Cores de Verificação (Digitando) ---
# Purple (acento)
line-ver-color=bd93f9
# Purple (acento)
ring-ver-color=bd93f9
# Current Line / Selection (cinza interno)
inside-ver-color=44475a
# Cyan (acento claro)
text-ver-color=8be9fd

# --- Cores de Erro (Senha Errada) ---
# Red
line-wrong-color=ff5555
# Red
ring-wrong-color=ff5555
# Current Line / Selection (cinza interno)
inside-wrong-color=44475a
# Red claro
text-wrong-color=ff6e6e

# --- Cores de Limpeza (Backspace) ---
# Cyan (acento claro)
line-clear-color=8be9fd
# Cyan (acento claro)
ring-clear-color=8be9fd
# Current Line / Selection (cinza interno)
inside-clear-color=44475a
# Cyan (acento claro)
text-clear-color=8be9fd
# Cyan (acento claro)
bs-hl-color=8be9fd